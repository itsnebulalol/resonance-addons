{
  "name": "resonance-addons",
  "description": "Resonance Addons is a collection of addons for Resonance.",
  "author": "Dominic Frye <me@itsnebula.net>",
  "license": "GPL-3.0",
  "version": "1.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/itsnebulalol/resonance-addons"
  },
  "homepage": "https://resonance.itsnebula.net",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun scripts/build.ts",
    "build:applemusic": "bun scripts/build.ts --addon=applemusic-addon",
    "build:lrclib": "bun scripts/build.ts --addon=lrclib-addon",
    "build:soundcloud": "bun scripts/build.ts --addon=soundcloud-addon",
    "build:spotify": "bun scripts/build.ts --addon=spotify-addon",
    "build:youtubemusic": "bun scripts/build.ts --addon=youtubemusic-addon",
    "smoke": "bun scripts/smoke.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "biome check --write .",
    "check:ci": "biome ci .",
    "lint": "biome lint .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@types/bun": "^1.3.11",
    "@types/node": "^25.5.0",
    "typescript": "^5"
  }
}
